# Copy to .env.local and fill with real values. .env.local is gitignored — never commit it.

# Supabase project the frontend talks to (apps-prod). There is no local Supabase stack.
VITE_SUPABASE_URL=YOUR-PROJECT-URL
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Postgres connection used by the migration and SQL-test runners (the container from `npm run db:up`).
AGORA_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
