# Copy to .env.local and fill with real values. .env.local is gitignored — never commit it.

# Supabase project (production: apps-prod; development: the local stack from `npx supabase start`)
VITE_SUPABASE_URL=YOUR-PROJECT-URL
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Postgres connection used by the migration and SQL-test runners (local stack only).
AGORA_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
